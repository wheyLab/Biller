{
  "name": "wheylab-biller",
  "private": true,
  "version": "0.1.0",
  "description": "Single-screen counter billing app for Whey Lab. Runs offline on 127.0.0.1.",
  "scripts": {
    "postinstall": "npm --prefix server install && npm --prefix client install",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server test",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -k -n server,client -c red,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "serve": "npm run build && npm start",
    "export-db": "npm --prefix server run export-db --",
    "backup": "npm --prefix server run backup"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
